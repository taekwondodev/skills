    {
      "id": "single-source-agent-writing",
      "checks": [
        {
          "file": "writing-for-agents/SKILL.md",
          "contains": [
            "Use this contract for agent-facing writing",
            "name a retrievable source or include the context needed to understand each claim",
            "Keep one source of truth per meaning.",
            "Keep scope tight.",
            "make branch-specific instructions conditional",
            "Define completion for each step or deliverable in observable, checkable terms",
            "Load [authoring.md](references/authoring.md)",
            "When authoring a skill, read [SKILL-MECHANICS.md](SKILL-MECHANICS.md) for frontmatter, invocation choice, and router skills."
          ]
        },
        {
          "file": "writing-for-agents/references/authoring.md",
          "contains": [
            "The parent [`SKILL.md`](../SKILL.md) is the source of truth for shared prose rules.",
            "This reference extends it with authoring design guidance."
          ]
        },
        {
          "file": "menu/SKILL.md",
          "not_contains": [
            "only source of truth for agent-facing prose and `unslop`"
          ]
        }
      ]
    },
    {
      "id": "architecture-not-forced-hexagonal",
      "checks": [
        {
          "file": "architect/SKILL.md",
          "contains": [
            "Use these references to compare the relevant candidate against concrete usage, not to select a pattern in advance.",
            "Prefer the design that hides more complexity behind a smaller, simpler public surface."
          ]
        }
      ]
    },
    {
      "id": "separate-review-axes",
      "checks": [
        {
          "file": "code-review/SKILL.md",
          "contains": [
            "## Standards",
            "## Spec",
            "## Adversarial",
            "Do not merge or rerank the axes into one score",
            "rerun affected axes",
            "Require reviewers to read their own sources",
            "accessible source paths",
            "The parent does not preload or paste the full standards corpus",
            "not permission to execute `architect` inside review"
          ]
        }
      ]
    },
    {
      "id": "skills-are-isolated",
      "type": "contamination",
      "patterns": [
        {
          "label": "external policy provenance",
          "regex": "\\b(?:comes only from|belongs only to|exists only in|only source of truth for|(?:pipeline|checkpoints|invocation rules)[^\\n]*lives? in[^\\n]*skill)\\b"
        },
        {
          "label": "hidden history",
          "regex": "\\b(?:as (?:we )?(?:(?:previously|already|earlier) (?:agreed|established|stated|said|noted|decided)|(?:agreed|established|stated|said|noted|decided) (?:previously|earlier)|(?:already )?discussed)|previously agreed|according to (?:the )?system (?:rule|policy))\\b"
        },
        {
          "label": "external instruction file",
          "regex": "^\\s*(?:[-*]\\s*)?(?:read|load|follow|apply|consult|obey|use|review)\\b[^\\n]*(?:AGENTS\\.md|CLAUDE\\.md|HERMES\\.md|GEMINI\\.md|copilot-instructions\\.md|\\.cursorrules|config\\.ya?ml|profile configuration|system prompt|project instruction file)"
        }
      ]
    },
    {
      "id": "no-stale-design-skill",
      "glob": "*/SKILL.md",
      "not_contains": [
        "`design`",
        "`/design`"
      ]
    },
    {
      "id": "references-resolve",
      "type": "references_resolve"
    }
  ]
}
