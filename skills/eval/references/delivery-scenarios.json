{
  "version": 3,
  "expected_scenario_count": 13,
  "scenarios": [
    {
      "id": "resolve-delivery-before-edits",
      "prompt": "Implement a task using the repository delivery default, an explicit task override, or a question when both are absent.",
      "capabilities": ["implement"],
      "checks": [
        {"file": "implement/SKILL.md", "contains": ["references/delivery.md", "before editing", "Stop with the reviewed changes uncommitted"]},
        {"file": "implement/references/delivery.md", "contains": ["docs/agents/delivery.md", "explicit task choice", "ask the user", "not authorization"]}
      ]
    },
    {
      "id": "prepare-or-reuse-pr-branch",
      "prompt": "Prepare PR work without creating redundant branches or discarding unrelated work; handle a late request without rewriting history.",
      "capabilities": ["implement", "pr"],
      "checks": [
        {"file": "implement/references/delivery.md", "contains": ["Reuse", "before edits", "late PR request", "already integrated", "reset", "worktree", "base...HEAD"]},
        {"file": "pr/SKILL.md", "contains": ["../implement/references/delivery.md", "head repository", "base branch"]}
      ]
    },
    {
      "id": "commit-only-reviewed-scope",
      "prompt": "Commit task changes including deletions and paths with spaces while preserving unrelated staged work.",
      "capabilities": ["commit"],
      "checks": [
        {"file": "commit/SKILL.md", "contains": ["git diff --cached", "unrelated staged", "git add --", "deletions", "local-only", "reviewed scope"], "not_contains": ["git add $(git ls-files", "git add .", "git add -A"]}
      ]
    },
    {
      "id": "direct-delivery-before-issue-closure",
      "prompt": "Deliver directly, leave an issue open after a failed push, and avoid treating a closed issue as push permission.",
      "capabilities": ["commit"],
      "checks": [
        {"file": "commit/SKILL.md", "contains": ["integration", "before closing", "If push", "already closed", "explicit", "ls-remote"]}
      ]
    },
    {
      "id": "pr-full-scope-and-retry",
      "prompt": "Create or update one PR for the entire task range, preserving human edits and stopping on an ambiguous or finished PR lifecycle.",
      "capabilities": ["pr"],
      "checks": [
        {"file": "pr/SKILL.md", "contains": ["base...HEAD", "base..HEAD", "local-only", "human", "same open PR", "closed or merged", "--head", "--base", "head SHA"]}
      ]
    },
    {
      "id": "issue-link-is-not-integration",
      "prompt": "Link fully resolved implementation issues for closure on merge into the default branch, respecting explicit keep-open requests. Keep issues open while their PR is open.",
      "capabilities": ["pr"],
      "checks": [
        {"file": "pr/SKILL.md", "contains": ["use `Closes #N` by default", "fully resolved issue scope", "default branch", "non-closing", "partial", "explicit user request", "merge", "issue open", "expected closing-issue set", "branch-inherited", "unverified"]}
      ]
    },
    {
      "id": "issue-mapping-survives-handoffs",
      "prompt": "Carry child-ticket identity through branch, commit, and PR handoffs, including multi-ticket units and work without an issue.",
      "capabilities": ["implement", "commit", "pr"],
      "checks": [
        {"file": "implement/references/delivery.md", "contains": ["qualified implementation issue references (or none)", "not its parent spec", "multi-ticket unit", "commit and PR handoffs", "<type>/<issue-number>-<slug>", "Preserve existing branch names"]},
        {"file": "commit/SKILL.md", "contains": ["missing route, branch, or issue mapping"]},
        {"file": "pr/SKILL.md", "contains": ["missing route, branch, or issue mapping"]}
      ]
    },
    {
      "id": "commit-references-match-issue-scope",
      "prompt": "Reference every implementation issue covered by the commit without closing it, confusing repositories, or silently dropping identifiers to fit the subject cap.",
      "capabilities": ["commit"],
      "checks": [
        {"file": "commit/SKILL.md", "contains": ["each implementation issue covered by the commit", "non-closing reference", "repository-qualified", "Keep identifiers intact", "message-length conflicts", "issue references against the recorded mapping"]}
      ]
    },
    {
      "id": "native-links-require-real-readback",
      "prompt": "Distinguish a branch name or body mention from a native GitHub link; apply the PR issue-link rules to branch associations and preserve local-only authority, remote refs, pagination, and the expected closing set.",
      "capabilities": ["implement", "pr"],
      "checks": [
        {"file": "implement/references/delivery.md", "contains": ["native branch associations", "docs/agents/issue-tracker.md", "authorized", "pending", "../../pr/SKILL.md#3-prepare-the-description", "intended ticket scope and base"]},
        {"file": "dev-cycle-setup/issue-tracker-github.md", "contains": ["Native development links", "Issue.linkedBranches", "createLinkedBranch", "repositoryId", "oid", "Existing remote branch", "PullRequest.closingIssuesReferences", "Paginate", "auto-link", "preserves the ref"]},
        {"file": "pr/SKILL.md", "contains": ["every covered implementation issue", "complete native closing-issue set", "including an empty set", "published body", "prepare pending branch links"]}
      ]
    },
    {
      "id": "visual-description-and-real-checks",
      "prompt": "Explain the outcome, changed behavior, risks, and verification in a PR with one captured primary visual, fixed-shape risk and verification tables, and a counted word budget. Allow text-only explanations for simple fixes with a stated reason, and make supporting details available on demand.",
      "capabilities": ["pr"],
      "checks": [
        {"file": "pr/SKILL.md", "contains": ["references/description.md", "Capture the primary visual", "every count", "pending", "unavailable", "delivery/1"]},
        {"file": "pr/references/description.md", "contains": ["Why the change", "Change outline", "Reviewer attention", "Verification", "template", "Skeleton", "| Risk | Consequence | Guard | Where |", "| Check | Result | Evidence |", "Remote CI", "at most 150", "at most 5 items", "Capture before drafting", "terminal test harness", "screenshots", "cannot attach uploaded images", "Mermaid", "At most 8 nodes", "at most 4 words", "text-only", "Reader check", "<details>", "reviewer access", "Omit empty optional sections"]}
      ]
    },
    {
      "id": "history-recommendation-not-rewrite",
      "prompt": "Recommend a merge strategy for a cohesive change developed through fixups, and for a history with independently useful commits. Respect repository policy, distinguish squash at merge from branch cleanup, and leave execution subject to separate authorization.",
      "capabilities": ["pr"],
      "checks": [
        {"file": "pr/SKILL.md", "contains": ["references/history.md", "merge policy", "without force", "Publication never merges"]},
        {"file": "pr/references/history.md", "contains": ["independently meaningful", "Squash and merge", "Commits tab", "branch rewrite", "separate authorization", "squash-message defaults", "recommendation"]}
      ]
    },
    {
      "id": "setup-and-routing-share-policy",
      "prompt": "Configure one delivery policy and route implementation, commits, and PRs without a new deliver skill.",
      "capabilities": ["dev-cycle", "dev-cycle-setup", "commit", "pr"],
      "checks": [
        {"file": "dev-cycle/SKILL.md", "contains": ["`commit`", "`pr`", "references/delivery.md"]},
        {"file": "dev-cycle-setup/SKILL.md", "contains": ["docs/agents/delivery.md", "delivery.md", "direct", "pr"]},
        {"file": "dev-cycle-setup/issue-tracker-github.md", "contains": ["/commit", "/pr", "docs/agents/delivery.md"]}
      ]
    },
    {
      "id": "land-after-publication",
      "prompt": "After publishing a PR, ask whether to keep it open or land it. Landing squash-merges with the verified head pinned, fast-forwards the base checkout, removes only the worktrees the workflow recorded for the task, reports any other worktree holding the branch, deletes the local branch, and reports each expected issue as closed, open, or unverified.",
      "capabilities": ["pr", "implement", "dev-cycle-setup"],
      "checks": [
        {"file": "pr/SKILL.md", "contains": ["keep the PR open or land it", "references/landing.md", "Publication never merges"]},
        {"file": "pr/references/landing.md", "contains": ["Already merged", "pulls/<number>/merge", "\"merge_method\":\"squash\"", "\"sha\":\"<verified head>\"", "<PR title> (#N)", "fast-forward only", "worktrees recorded for this task in the task record", "with the recorded branch checked out", "`git worktree remove --force -- <path>`", "stale", "`held`", "`git branch -D <task-branch>`", "`closed`, `open`, or `unverified`", "delivery/1"]},
        {"file": "implement/references/delivery.md", "contains": ["record its path and branch in the task record"]},
        {"file": "dev-cycle-setup/SKILL.md", "contains": ["`HANDOFF.md`", ".gitignore"]}
      ]
    }
  ],
  "global_checks": [
    {"id": "references-resolve", "type": "references_resolve"}
  ]
}
